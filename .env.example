# ==========================================
# Konfigurasi Supabase
# ==========================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ==========================================
# Konfigurasi Mayar Payment Gateway
# ==========================================
MAYAR_API_KEY=your-mayar-api-key
MAYAR_WEBHOOK_SECRET=your-mayar-webhook-secret
MAYAR_BASE_URL=https://api.mayar.io/hl/v2

# ==========================================
# Konfigurasi URL Aplikasi
# ==========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==========================================
# Konfigurasi Resend Email Service
# ==========================================
# Dapatkan API Key di https://resend.com
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=LMS Pijar Aksara <onboarding@resend.dev>

# Token pengaman untuk Cron Job (Pengingat Batas Bayar 3 Jam)
CRON_SECRET=pijar_aksara_cron_secret_secure_key_123
